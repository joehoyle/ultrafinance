aws_profile = "joehoyle"
aws_region  = "ca-central-1"
name        = "ultrafinance"
# After bootstrapping ECR and pushing an image, save the digest URI here:
# image_uri = "123456789012.dkr.ecr.ca-central-1.amazonaws.com/ultrafinance@sha256:..."
# Supply typesafe_api_key through the TF_VAR_typesafe_api_key environment variable.

# Only this repository's main branch can assume the CI deploy role.
github_repository    = "joehoyle/ultrafinance"
github_owner_id      = "161683"
github_repository_id = "1410780058"
# If this AWS account already has a GitHub OIDC provider, reuse its ARN:
# github_oidc_provider_arn = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"

# CLI login credentials are exported in memory by infra/tofu.sh.
aws_use_cli_credentials = true
aws_account_id          = "123456789012"

# Set this, then import the existing zone before applying (see README).
# domain_name = "ultrafinance.app"
