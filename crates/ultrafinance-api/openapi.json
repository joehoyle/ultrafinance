{
  "openapi": "3.1.0",
  "info": {
    "title": "Ultrafinance API",
    "description": "Synchronous merchant enrichment. Requests return a completed result, with no background jobs. This API currently requires no client authentication.",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Check whether the HTTP service is running.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Service is running",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        }
      }
    },
    "/v1/enrich": {
      "post": {
        "tags": [
          "Enrichment"
        ],
        "summary": "Enrich a transaction with a merchant from the catalog.",
        "description": "Only description is required; unknown top-level fields are rejected. The JSON body\nis limited to 64 KiB. A unique verified exact alias can resolve locally; fuzzy or\nambiguous candidates require provider evaluation. No candidates or insufficient\nevidence returns unresolved with null data, not an HTTP error. Transaction fields\nand candidate records are sent to TypeSafe when evaluation runs. The overall\nenrichment deadline is 25 seconds. Configuration, database and provider failures\nreturn 502 rather than unresolved.",
        "operationId": "enrich",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnrichRequest"
              },
              "example": {
                "amount": "142.97",
                "country": "CA",
                "currency": "CAD",
                "description": "LS",
                "extra": {
                  "bank_category": [
                    "Food and Drink",
                    "Restaurants"
                  ]
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Completed enrichment; matched or unresolved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnrichResponse"
                },
                "examples": {
                  "matched": {
                    "value": {
                      "merchant": {
                        "data": {
                          "country": "CA",
                          "id": "mer_example",
                          "name": "Example Café"
                        },
                        "status": "matched"
                      }
                    }
                  },
                  "unresolved": {
                    "value": {
                      "merchant": {
                        "data": null,
                        "status": "unresolved"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Malformed JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "413": {
            "description": "Request body exceeds 64 KiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "415": {
            "description": "Missing or unsupported JSON content type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "Invalid fields, unknown fields, or failed validation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error": {
                    "code": "invalid_request",
                    "message": "country must be a two-letter uppercase code"
                  }
                }
              }
            }
          },
          "502": {
            "description": "Enrichment failed, including configuration or provider errors",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error": {
                    "code": "enrichment_failed",
                    "message": "Merchant evaluation failed"
                  }
                }
              }
            }
          },
          "504": {
            "description": "Enrichment exceeded the 25-second deadline",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error": {
                    "code": "enrichment_timeout",
                    "message": "Merchant evaluation timed out"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/enrich/batch": {
      "post": {
        "tags": [
          "Enrichment"
        ],
        "summary": "Enrich 1 to 100 transactions, preserving input order.\nEach transaction has an isolated provider question. Verified exact matches and\nempty candidate sets resolve locally. Provider calls are packed within byte\nbudgets, with at most four in flight. Invalid transactions and provider failures\nproduce per-item errors alongside successful results. The body limit is 1 MiB;\nthe overall deadline is 55 seconds, after which the whole request returns 504.",
        "operationId": "enrich_batch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchEnrichRequest"
              },
              "example": {
                "transactions": [
                  {
                    "country": "CA",
                    "description": "EXAMPLE CAFE"
                  }
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Ordered results, including per-item failures",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchEnrichResponse"
                }
              }
            }
          },
          "400": {
            "description": "Malformed JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "413": {
            "description": "Request body exceeds 1 MiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "415": {
            "description": "Missing or unsupported JSON content type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "Invalid envelope or transaction count",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "504": {
            "description": "Batch exceeded the 55-second deadline",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/merchants": {
      "get": {
        "tags": [
          "Merchants"
        ],
        "summary": "Explore the merchant catalog without calling the AI provider.\nBrowsing is alphabetical; search ranks a bounded candidate pool rather than\nmatching every catalog row. Search totals refer to that pool (at most 255 for\nexact alias collisions, otherwise 100), not the full catalog. Results include\nmerchant records only, without internal scoring or import evidence.",
        "operationId": "merchants",
        "parameters": [
          {
            "name": "q",
            "in": "path",
            "description": "Optional name or alias search; at most 256 bytes. Searches return a bounded candidate pool.",
            "required": true,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "country",
            "in": "path",
            "description": "Two-letter uppercase country code. Search also includes merchants with unknown country.",
            "required": true,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "limit",
            "in": "path",
            "description": "Page size, from 1 to 100. Defaults to 20.",
            "required": true,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          {
            "name": "offset",
            "in": "path",
            "description": "Number of results to skip, up to 1,000,000. Defaults to 0.",
            "required": true,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated catalog records or ranked search candidates",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MerchantPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Catalog unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "504": {
            "description": "Catalog query timed out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "BatchEnrichRequest": {
        "type": "object",
        "required": [
          "transactions"
        ],
        "properties": {
          "transactions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EnrichRequest"
            },
            "description": "Between 1 and 100 transactions. Results preserve this order.",
            "maxItems": 100,
            "minItems": 1
          }
        },
        "additionalProperties": false
      },
      "BatchEnrichResponse": {
        "type": "object",
        "required": [
          "results"
        ],
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BatchItemResult"
            }
          }
        }
      },
      "BatchItemResult": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "data",
              "status"
            ],
            "properties": {
              "data": {
                "$ref": "#/components/schemas/EnrichResponse"
              },
              "status": {
                "type": "string",
                "enum": [
                  "success"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "code",
              "message",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "error"
                ]
              }
            }
          }
        ]
      },
      "EnrichRequest": {
        "type": "object",
        "required": [
          "description"
        ],
        "properties": {
          "amount": {
            "type": [
              "string",
              "null"
            ],
            "description": "Decimal amount as a string. The service does not validate its numeric format."
          },
          "country": {
            "type": [
              "string",
              "null"
            ],
            "description": "Two uppercase ASCII letters. Narrows merchant candidates, not the location of an outlet.",
            "pattern": "^[A-Z]{2}$"
          },
          "currency": {
            "type": [
              "string",
              "null"
            ],
            "description": "Three uppercase ASCII letters, for example CAD.",
            "pattern": "^[A-Z]{3}$"
          },
          "date": {
            "type": [
              "string",
              "null"
            ],
            "description": "Transaction date, conventionally YYYY-MM-DD. The service does not validate its format."
          },
          "description": {
            "type": "string",
            "description": "Bank transaction description. Must contain nonblank text and be at most 4096 UTF-8 bytes."
          },
          "extra": {
            "type": "object",
            "description": "Additional evidence as an object with arbitrary JSON values. Sent to the provider when evaluation runs.",
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "EnrichResponse": {
        "type": "object",
        "required": [
          "merchant"
        ],
        "properties": {
          "attributions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Source attribution for matched merchants. Omitted when empty."
          },
          "merchant": {
            "$ref": "#/components/schemas/MerchantResult"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "invalid_request, enrichment_failed, or enrichment_timeout."
          },
          "message": {
            "type": "string"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Service liveness indicator. Does not check the database or upstream provider.",
            "example": "ok"
          }
        }
      },
      "Merchant": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "country": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string",
            "description": "Stable ID in this service's merchant catalog."
          },
          "logo_source": {
            "type": [
              "string",
              "null"
            ]
          },
          "logo_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "website": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "MerchantPage": {
        "type": "object",
        "required": [
          "merchants",
          "total",
          "limit",
          "offset"
        ],
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 0
          },
          "merchants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Merchant"
            }
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "MerchantResult": {
        "oneOf": [
          {
            "type": "object",
            "description": "A supported catalog match, with its merchant record.",
            "required": [
              "data",
              "status"
            ],
            "properties": {
              "data": {
                "$ref": "#/components/schemas/Merchant"
              },
              "status": {
                "type": "string",
                "enum": [
                  "matched"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "Insufficient evidence or no candidates. The data field is always null.",
            "required": [
              "data",
              "status"
            ],
            "properties": {
              "data": {
                "type": "null"
              },
              "status": {
                "type": "string",
                "enum": [
                  "unresolved"
                ]
              }
            }
          }
        ]
      }
    }
  },
  "tags": [
    {
      "name": "Enrichment",
      "description": "Resolve bank descriptions against the merchant catalog"
    },
    {
      "name": "Merchants",
      "description": "Browse and search the merchant catalog"
    },
    {
      "name": "Health",
      "description": "Service liveness"
    }
  ]
}
