# Copy to .env and add your Jev credential. Keep .env private.
# Local CLI/API processes read environment variables; load this file with:
# set -a; source .env; set +a
# OpenTofu reads typesafe_api_key from ignored infra/terraform.tfvars.
TYPESAFE_API_KEY=

# Optional: used only by explicit research or opted-in enrichment fallback.
OPENAI_API_KEY=
ULTRAFINANCE_RESEARCH_MODEL=gpt-6.1-sol
